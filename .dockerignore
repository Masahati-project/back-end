# Version control
.git
.gitignore
.github

# Local environment files - must never end up in the image
.env
.env.*
!.env.example

# Dependencies are reinstalled inside the image
vendor
node_modules

# Cached/compiled assets
public/build
public/hot
public/storage
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*.php

# Tests are not needed at runtime
tests
phpunit.xml

# Local tooling
scripts
.claude
*.log
